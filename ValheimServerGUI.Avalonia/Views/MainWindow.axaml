<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ValheimServerGUI.Avalonia.ViewModels"
        xmlns:conv="using:ValheimServerGUI.Avalonia.Converters"
        xmlns:game="using:ValheimServerGUI.Game"
        xmlns:mods="using:ValheimServerGUI.Game.Mods"
        x:Class="ValheimServerGUI.Avalonia.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="Valheim Server GUI (Avalonia)"
        Width="1100" Height="720"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <conv:NegateBoolConverter x:Key="NegateBool"/>
    <conv:StatusToBrushConverter x:Key="StatusToBrush"/>
    <conv:PlayerStatusToBrushConverter x:Key="PlayerStatusToBrush"/>
    <conv:PlatformToBrushConverter x:Key="PlatformToBrush"/>
    <conv:LogSeverityToBrushConverter x:Key="LogSeverityToBrush"/>

    <!-- Two hand-drawn glyphs, so the dense read-only rows can use an icon button instead of a
         column of identical "Copy" text buttons. Drawn here rather than pulled from an icon pack
         to avoid a new dependency for two shapes. -->
    <StreamGeometry x:Key="CopyIcon">M0.7,0.7 H7.3 V9.3 H0.7 Z M4.7,4.7 H11.3 V13.3 H4.7 Z</StreamGeometry>
    <StreamGeometry x:Key="EyeIcon">M0.5,7 C3,3.4 5,2.7 7,2.7 C9,2.7 11,3.4 13.5,7 C11,10.6 9,11.3 7,11.3 C5,11.3 3,10.6 0.5,7 Z</StreamGeometry>
    <StreamGeometry x:Key="EyePupilIcon">M7,4.9 A2.1,2.1 0 1 0 7.01,4.9 Z</StreamGeometry>
  </Window.Resources>

  <DockPanel>
    <!-- Menu bar -->
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="New Profile..." Command="{Binding NewProfileCommand}"/>
        <MenuItem Header="Save Profile" Command="{Binding SaveProfileCommand}"/>
        <MenuItem Header="Save Profile As..." Command="{Binding SaveProfileAsCommand}"/>
        <MenuItem Header="Remove Profile" Command="{Binding RemoveProfileCommand}"/>
        <Separator/>
        <MenuItem Header="Preferences..." Command="{Binding ShowPreferencesCommand}"/>
        <MenuItem Header="Open Settings Directory..." Command="{Binding OpenSettingsDirectoryCommand}"/>
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="Online Manual" Command="{Binding OpenManualCommand}"/>
        <MenuItem Header="Port Forwarding" Command="{Binding ShowPortForwardingCommand}"/>
        <MenuItem Header="GitHub Issues" Command="{Binding OpenIssuesCommand}"/>
        <MenuItem Header="Check for Updates" Command="{Binding CheckForUpdatesCommand}"/>
        <Separator/>
        <MenuItem Header="About..." Command="{Binding ShowAboutCommand}"/>
      </MenuItem>
    </Menu>

    <!-- Top bar: profile selection, status, actions -->
    <Border DockPanel.Dock="Top" Padding="12,8" Background="{DynamicResource VsgPanelBrush}">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8">
        <TextBlock Text="Profile:" VerticalAlignment="Center"/>
        <ComboBox Grid.Column="1"
                  ItemsSource="{Binding Profiles}"
                  SelectedItem="{Binding SelectedProfile}"
                  MinWidth="180"
                  HorizontalAlignment="Left"/>

        <TextBlock Grid.Column="2" Text="Status:" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="3" Text="{Binding StatusText}" VerticalAlignment="Center" FontWeight="SemiBold"
                   Foreground="{Binding StatusText, Converter={StaticResource StatusToBrush}}"/>

        <Button Grid.Column="4" Content="Start" Command="{Binding ServerControls.StartCommand}" MinWidth="80"/>
        <Button Grid.Column="5" Content="Restart" Command="{Binding ServerControls.RestartCommand}" MinWidth="80"/>
        <Button Grid.Column="6" Content="Stop" Command="{Binding ServerControls.StopCommand}" MinWidth="80"/>

        <Button Grid.Column="7" Content="Ports" Command="{Binding ShowPortForwardingCommand}"/>
        <Button Grid.Column="8" Content="Discord" Command="{Binding ShowDiscordCommand}"/>
        <Button Grid.Column="9" Content="Preferences" Command="{Binding ShowPreferencesCommand}"/>
        <Button Grid.Column="10" Content="About" Command="{Binding ShowAboutCommand}"/>
      </Grid>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Padding="8,4" Background="{DynamicResource VsgPanelBrush}">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold"
                     Foreground="{Binding StatusText, Converter={StaticResource StatusToBrush}}"/>
          <TextBlock Text="Uptime:"/>
          <TextBlock Text="{Binding Uptime}"/>
          <TextBlock Text="External IP:"/>
          <TextBlock Text="{Binding ExternalIpAddress}"/>
          <TextBlock Text="Internal IP:"/>
          <TextBlock Text="{Binding InternalIpAddress}"/>
        </StackPanel>
        <Button Grid.Column="1" Content="{Binding UpdateStatusText}" Command="{Binding CheckForUpdatesCommand}"
                IsVisible="{Binding UpdateStatusText, Converter={x:Static ObjectConverters.IsNotNull}}"/>
      </Grid>
    </Border>

    <TabControl Margin="8">
      <!-- Server -->
      <TabItem Header="Server">
        <ScrollViewer>
<Grid ColumnDefinitions="*,320" ColumnSpacing="12" Margin="8">

            <!-- ================= Left: configuration ================= -->
            <StackPanel Grid.Column="0" Spacing="12">

              <!-- Server -->
              <Border Padding="16" CornerRadius="4" Background="{DynamicResource VsgPanelBrush}">
                <StackPanel Spacing="12">
                  <TextBlock Text="Server" FontSize="16" FontWeight="SemiBold"/>

                  <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="8">
                    <TextBlock Text="Server Name:" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding ServerControls.ServerName}" IsEnabled="{Binding ServerControls.CanEdit}" PlaceholderText="Enter a server name"/>

                    <TextBlock Grid.Row="1" Text="Port:" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Row="1" Grid.Column="1" Width="140" HorizontalAlignment="Left"
                                   Value="{Binding ServerControls.Port}" Minimum="1" Maximum="65535" Increment="1" FormatString="N0"
                                   IsEnabled="{Binding ServerControls.CanEdit}"/>

                    <TextBlock Grid.Row="2" Text="Password:" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ServerControls.Password}" PasswordChar="&#x2022;"
                             RevealPassword="{Binding ServerControls.ShowPassword}"
                             IsEnabled="{Binding ServerControls.CanEdit}" PlaceholderText="Enter a password">
                      <TextBox.InnerRightContent>
                        <StackPanel Orientation="Horizontal" Spacing="2">
                          <Button Command="{Binding ServerControls.CopyPasswordCommand}" Padding="6"
                                  ToolTip.Tip="Copy the password">
                            <Path Data="{StaticResource CopyIcon}" Stroke="{DynamicResource VsgMutedTextBrush}"
                                  StrokeThickness="1.2" Fill="Transparent"/>
                          </Button>
                          <ToggleButton IsChecked="{Binding ServerControls.ShowPassword, Mode=TwoWay}" Padding="6"
                                        ToolTip.Tip="Show or hide the password">
                            <Grid>
                              <Path Data="{StaticResource EyeIcon}" Stroke="{DynamicResource VsgMutedTextBrush}"
                                    StrokeThickness="1.2" Fill="Transparent"/>
                              <Path Data="{StaticResource EyePupilIcon}" Fill="{DynamicResource VsgMutedTextBrush}"/>
                            </Grid>
                          </ToggleButton>
                        </StackPanel>
                      </TextBox.InnerRightContent>
                    </TextBox>

                    <!-- The toggle replaces the old New/Existing radio pair, which forced the world
                       field onto a second line anyway. The field gets its own row so the row
                       above can never overflow the column at the minimum window width. -->
                    <TextBlock Grid.Row="3" Text="World:" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                      <ToggleButton IsChecked="{Binding ServerControls.IsNewWorld, Mode=TwoWay}" Content="+ New"
                                    IsEnabled="{Binding ServerControls.CanEdit}" VerticalAlignment="Center"
                                    ToolTip.Tip="Host a new world instead of an existing one"/>
                      <Button Content="Refresh" Command="{Binding ServerControls.RefreshWorldsCommand}" VerticalAlignment="Center"/>
                      <Button Content="Difficulty..." Command="{Binding OpenWorldSettingsCommand}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBox Grid.Row="4" Grid.ColumnSpan="2" Text="{Binding ServerControls.NewWorldName}"
                             IsVisible="{Binding ServerControls.IsNewWorld}"
                             IsEnabled="{Binding ServerControls.CanEdit}" PlaceholderText="Name for the new world"/>
                    <ComboBox Grid.Row="4" Grid.ColumnSpan="2" ItemsSource="{Binding ServerControls.WorldNames}"
                              SelectedItem="{Binding ServerControls.ExistingWorldName}"
                              IsVisible="{Binding ServerControls.IsNewWorld, Converter={StaticResource NegateBool}}"
                              IsEnabled="{Binding ServerControls.CanEdit}"/>

                    <TextBlock Grid.Row="5" Text="Join Options:" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Spacing="16">
                      <CheckBox Content="Community Server (Public)" IsChecked="{Binding ServerControls.IsPublic}" IsEnabled="{Binding ServerControls.CanEdit}"/>
                      <CheckBox Content="Enable Crossplay" IsChecked="{Binding ServerControls.IsCrossplay}" IsEnabled="{Binding ServerControls.CanEdit}"/>
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>

              <!-- Storage & backups -->
              <Border Padding="16" CornerRadius="4" Background="{DynamicResource VsgPanelBrush}">
                <StackPanel Spacing="12">
                  <TextBlock Text="Storage &amp; backups" FontSize="16" FontWeight="SemiBold"/>

                  <Grid ColumnDefinitions="140,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="8">
                    <TextBlock Text="Server executable:" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding ServerControls.ServerExePath}" IsEnabled="{Binding ServerControls.CanEdit}"/>
                    <Button Grid.Column="2" Content="Browse..." Command="{Binding ServerControls.BrowseServerExeCommand}"/>

                    <TextBlock Grid.Row="1" Text="Save data folder:" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ServerControls.SaveDataFolderPath}" IsEnabled="{Binding ServerControls.CanEdit}"/>
                    <Button Grid.Row="1" Grid.Column="2" Content="Browse..." Command="{Binding ServerControls.BrowseSaveFolderCommand}"/>

                    <!-- The server takes raw seconds, so the field stays free-form and the hint
                         just restates it the way a person would say it. A preset dropdown would
                         make values like 45 or 90 minutes unreachable. -->
                    <TextBlock Grid.Row="2" Text="Save interval (s):" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Row="2" Grid.Column="1" Width="140" HorizontalAlignment="Left"
                                   Value="{Binding ServerControls.SaveInterval}" Minimum="1" Increment="1" FormatString="N0"
                                   IsEnabled="{Binding ServerControls.CanEdit}"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding ServerControls.SaveIntervalHint}"
                               VerticalAlignment="Center" Foreground="{DynamicResource VsgMutedTextBrush}"/>

                    <TextBlock Grid.Row="3" Text="Backups kept:" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Row="3" Grid.Column="1" Width="140" HorizontalAlignment="Left"
                                   Value="{Binding ServerControls.BackupCount}" Minimum="1" Increment="1" FormatString="N0"
                                   IsEnabled="{Binding ServerControls.CanEdit}"/>

                    <TextBlock Grid.Row="4" Text="Short backup (s):" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Row="4" Grid.Column="1" Width="140" HorizontalAlignment="Left"
                                   Value="{Binding ServerControls.BackupShortInterval}" Minimum="1" Increment="1" FormatString="N0"
                                   IsEnabled="{Binding ServerControls.CanEdit}"/>
                    <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding ServerControls.BackupShortHint}"
                               VerticalAlignment="Center" Foreground="{DynamicResource VsgMutedTextBrush}"/>

                    <TextBlock Grid.Row="5" Text="Long backup (s):" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Row="5" Grid.Column="1" Width="140" HorizontalAlignment="Left"
                                   Value="{Binding ServerControls.BackupLongInterval}" Minimum="1" Increment="1" FormatString="N0"
                                   IsEnabled="{Binding ServerControls.CanEdit}"/>
                    <TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding ServerControls.BackupLongHint}"
                               VerticalAlignment="Center" Foreground="{DynamicResource VsgMutedTextBrush}"/>
                  </Grid>

                  <!-- Save timings live here rather than in the narrow status column: the
                       timestamp plus duration collided with its own label at 320px. Both
                       values only appear once the server has saved, hence the placeholders. -->
                  <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto" RowSpacing="4" ColumnSpacing="8" Margin="0,4,0,0">
                    <TextBlock Text="Last world save:" Foreground="{DynamicResource VsgMutedTextBrush}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LastWorldSaveText, TargetNullValue=Not saved yet}"
                               HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Row="1" Text="Average save:" Foreground="{DynamicResource VsgMutedTextBrush}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AverageWorldSaveText, TargetNullValue=Not saved yet}"
                               HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                  </Grid>
                </StackPanel>
              </Border>

              </StackPanel>

            <!-- ================= Right: live state ================= -->
            <StackPanel Grid.Column="1" Spacing="12">

              <Border Padding="16" CornerRadius="4" Background="{DynamicResource VsgPanelBrush}">
                <StackPanel Spacing="10">
                  <TextBlock Text="Status" FontSize="16" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding StatusText}" FontSize="24" FontWeight="SemiBold"
                             Foreground="{Binding StatusText, Converter={StaticResource StatusToBrush}}"/>
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <TextBlock Text="Uptime" Foreground="{DynamicResource VsgMutedTextBrush}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Uptime}" HorizontalAlignment="Right"/>
                  </Grid>
                </StackPanel>
              </Border>

              <Border Padding="16" CornerRadius="4" Background="{DynamicResource VsgPanelBrush}">
                <StackPanel Spacing="12">
                  <TextBlock Text="Share this server" FontSize="16" FontWeight="SemiBold"/>
                  <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource VsgMutedTextBrush}"
                             Text="Address and port together - copy it and send it to whoever should join."/>

                  <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="8">
                    <TextBlock Text="Invite code" Foreground="{DynamicResource VsgMutedTextBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding InviteCode}" FontFamily="Consolas" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Command="{Binding CopyInviteCodeCommand}" Padding="6" ToolTip.Tip="Copy the invite code">
                      <Path Data="{StaticResource CopyIcon}" Stroke="{DynamicResource VsgMutedTextBrush}"
                            StrokeThickness="1.2" Fill="Transparent"/>
                    </Button>

                    <TextBlock Grid.Row="1" Text="External" Foreground="{DynamicResource VsgMutedTextBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ExternalAddress}" FontFamily="Consolas" VerticalAlignment="Center"/>
                    <Button Grid.Row="1" Grid.Column="2" Command="{Binding CopyExternalAddressCommand}" Padding="6" ToolTip.Tip="Copy the external address">
                      <Path Data="{StaticResource CopyIcon}" Stroke="{DynamicResource VsgMutedTextBrush}"
                            StrokeThickness="1.2" Fill="Transparent"/>
                    </Button>

                    <TextBlock Grid.Row="2" Text="LAN" Foreground="{DynamicResource VsgDisabledTextBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding InternalAddress}" FontFamily="Consolas"
                               VerticalAlignment="Center" Foreground="{DynamicResource VsgDisabledTextBrush}"/>
                    <Button Grid.Row="2" Grid.Column="2" Command="{Binding CopyInternalAddressCommand}" Padding="6" ToolTip.Tip="Copy the LAN address">
                      <Path Data="{StaticResource CopyIcon}" Stroke="{DynamicResource VsgDisabledTextBrush}"
                            StrokeThickness="1.2" Fill="Transparent"/>
                    </Button>

                    <TextBlock Grid.Row="3" Text="Loopback" Foreground="{DynamicResource VsgDisabledTextBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LocalAddress}" FontFamily="Consolas"
                               VerticalAlignment="Center" Foreground="{DynamicResource VsgDisabledTextBrush}"/>
                    <Button Grid.Row="3" Grid.Column="2" Command="{Binding CopyLocalAddressCommand}" Padding="6" ToolTip.Tip="Copy the loopback address">
                      <Path Data="{StaticResource CopyIcon}" Stroke="{DynamicResource VsgDisabledTextBrush}"
                            StrokeThickness="1.2" Fill="Transparent"/>
                    </Button>
                  </Grid>
                </StackPanel>
              </Border>

              <!-- Rarely touched settings sit in the right column rather than behind an
                   Expander in the left one: the Fluent expander header paints a dark inset
                   bar with a chevron that reads as foreign next to these flat cards, and the
                   left column is the one that has to scroll. -->
              <Border Padding="16" CornerRadius="4" Background="{DynamicResource VsgPanelBrush}">
                <StackPanel Spacing="12">
                  <TextBlock Text="Advanced &amp; startup" FontSize="16" FontWeight="SemiBold"/>
                  <CheckBox Content="Auto-start server on launch" IsChecked="{Binding ServerControls.AutoStart}" IsEnabled="{Binding ServerControls.CanEdit}"/>
                  <CheckBox Content="Write server logs to file" IsChecked="{Binding ServerControls.WriteServerLogsToFile}" IsEnabled="{Binding ServerControls.CanEdit}"/>
                  <TextBlock Text="Additional args" Foreground="{DynamicResource VsgMutedTextBrush}"/>
                  <TextBox Text="{Binding ServerControls.AdditionalArgs}" IsEnabled="{Binding ServerControls.CanEdit}" PlaceholderText="Additional command-line arguments"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </TabItem>

      <!-- Players -->
      <TabItem Header="Players">
        <Grid RowDefinitions="Auto,*,Auto" Margin="8" RowSpacing="4">
          <Grid Grid.Row="0" ColumnDefinitions="*,100,110,150" Margin="8,4,8,0">
            <TextBlock Grid.Column="0" Text="Player" FontWeight="SemiBold" Foreground="{DynamicResource VsgMutedTextBrush}"/>
            <TextBlock Grid.Column="1" Text="Platform" FontWeight="SemiBold" Foreground="{DynamicResource VsgMutedTextBrush}"/>
            <TextBlock Grid.Column="2" Text="Status" FontWeight="SemiBold" Foreground="{DynamicResource VsgMutedTextBrush}"/>
            <TextBlock Grid.Column="3" Text="Last seen" FontWeight="SemiBold" Foreground="{DynamicResource VsgMutedTextBrush}"/>
          </Grid>

          <ListBox Grid.Row="1"
                   ItemsSource="{Binding Players.Players}"
                   SelectedItem="{Binding Players.SelectedPlayer}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:PlayerRowViewModel">
                <Grid ColumnDefinitions="*,100,110,150">
                  <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"
                             Foreground="{Binding StatusKind, Converter={StaticResource PlayerStatusToBrush}}"/>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Width="20" Height="20" CornerRadius="10" VerticalAlignment="Center"
                            Background="{Binding Platform, Converter={StaticResource PlatformToBrush}}">
                      <TextBlock Text="{Binding PlatformInitial}" FontSize="11" FontWeight="SemiBold"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Foreground="{DynamicResource VsgTextBrush}"/>
                    </Border>
                    <TextBlock Text="{Binding Platform}" VerticalAlignment="Center"/>
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding Status}" VerticalAlignment="Center"
                             Foreground="{Binding StatusKind, Converter={StaticResource PlayerStatusToBrush}}"/>
                  <TextBlock Grid.Column="3" Text="{Binding LastUpdated}" VerticalAlignment="Center"
                             Foreground="{DynamicResource VsgMutedTextBrush}"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <Button Content="Details..." Command="{Binding OpenPlayerDetailsCommand}"/>
            <Button Content="Remove Player" Command="{Binding Players.RemovePlayerCommand}"/>
            <Button Content="Refresh" Command="{Binding Players.RefreshCommand}"/>
          </StackPanel>
        </Grid>
      </TabItem>

      <!-- Mods & Backups -->
      <TabItem Header="Mods">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="8" RowSpacing="12">
          <Border Padding="12" CornerRadius="4" Background="{DynamicResource VsgPanelBrush}">
            <StackPanel Spacing="8">
              <TextBlock Text="BepInEx" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding Mods.BepInExStatus}"/>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Install / Update" Command="{Binding Mods.InstallBepInExCommand}"/>
                <Button Content="Install from file..." Command="{Binding Mods.InstallBepInExFromFileCommand}"/>
                <Button Content="Check for updates" Command="{Binding Mods.CheckBepInExUpdateCommand}"/>
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Grid.Row="1" Padding="12" CornerRadius="4" Background="{DynamicResource VsgPanelBrush}">
            <StackPanel Spacing="8">
              <TextBlock Text="Valheim Plus" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding Mods.ValheimPlusStatus}"/>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Install / Update" Command="{Binding Mods.InstallValheimPlusCommand}"/>
                <Button Content="Install from file..." Command="{Binding Mods.InstallValheimPlusFromFileCommand}"/>
                <Button Content="Check for updates" Command="{Binding Mods.CheckValheimPlusUpdateCommand}"/>
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Grid.Row="2" Padding="12" CornerRadius="4" Background="{DynamicResource VsgPanelBrush}">
            <StackPanel Spacing="8">
              <TextBlock Text="Installed mods" FontWeight="SemiBold"/>
              <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource VsgMutedTextBrush}"
                         Text="Read-only listing of BepInEx\plugins. Only Valheim Plus can be installed or updated from here; to remove a mod, move its .dll out of the plugins folder while the server is stopped."/>
              <Grid ColumnDefinitions="*,90,90,150" Margin="0,4,0,0">
                <TextBlock Grid.Column="0" Text="Mod" FontWeight="SemiBold" Foreground="{DynamicResource VsgMutedTextBrush}"/>
                <TextBlock Grid.Column="1" Text="Version" FontWeight="SemiBold" Foreground="{DynamicResource VsgMutedTextBrush}"/>
                <TextBlock Grid.Column="2" Text="Size" FontWeight="SemiBold" Foreground="{DynamicResource VsgMutedTextBrush}"/>
                <TextBlock Grid.Column="3" Text="Modified" FontWeight="SemiBold" Foreground="{DynamicResource VsgMutedTextBrush}"/>
              </Grid>
              <ListBox ItemsSource="{Binding Mods.InstalledPlugins}" MaxHeight="150">
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="6,1"/>
                    <Setter Property="MinHeight" Value="0"/>
                  </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="mods:InstalledPlugin">
                    <Grid ColumnDefinitions="*,90,90,150">
                      <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Text="{Binding Version}" VerticalAlignment="Center"
                                 Foreground="{DynamicResource VsgMutedTextBrush}"/>
                      <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}" VerticalAlignment="Center"
                                 Foreground="{DynamicResource VsgMutedTextBrush}"/>
                      <TextBlock Grid.Column="3" Text="{Binding ModifiedDisplay}" VerticalAlignment="Center"
                                 Foreground="{DynamicResource VsgMutedTextBrush}"/>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </Border>
          <Border Grid.Row="3" Padding="12" CornerRadius="4" Background="{DynamicResource VsgPanelBrush}">
            <StackPanel Spacing="8">
              <TextBlock Text="Mod folders &amp; config" FontWeight="SemiBold"/>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Open server folder" Command="{Binding Mods.OpenServerFolderCommand}"/>
                <Button Content="Open plugins" Command="{Binding Mods.OpenPluginsFolderCommand}"/>
                <Button Content="Open config" Command="{Binding Mods.OpenConfigFolderCommand}"/>
                <Button Content="Open BepInEx log" Command="{Binding Mods.OpenLogFileCommand}"/>
              </StackPanel>
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="6" ColumnSpacing="8">
                <TextBlock Text="Mod config files:" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Open selected config"
                        Command="{Binding Mods.OpenConfigFileCommand}"
                        CommandParameter="{Binding Mods.SelectedConfigFile}"/>
                <ListBox Grid.Row="1" Grid.ColumnSpan="2" Height="120"
                         ItemsSource="{Binding Mods.ConfigFiles}"
                         SelectedItem="{Binding Mods.SelectedConfigFile}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ModConfigFileViewModel">
                      <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </StackPanel>
          </Border>
          <Grid Grid.Row="4" RowDefinitions="Auto,Auto,*" RowSpacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Backups:" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding Mods.BackupsStatus}" VerticalAlignment="Center"/>
              <Button Content="Refresh" Command="{Binding Mods.RefreshCommand}"/>
              <Button Content="Open folder" Command="{Binding Mods.OpenBackupsFolderCommand}"/>
              <Button Content="Open selected" Command="{Binding Mods.OpenSelectedBackupCommand}"/>
            </StackPanel>
            <ListBox Grid.Row="1" ItemsSource="{Binding Mods.Backups}" SelectedItem="{Binding Mods.SelectedBackup}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:BackupRowViewModel">
                  <Grid ColumnDefinitions="*,160,90">
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Date}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding Size}" VerticalAlignment="Center"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Grid>
      </TabItem>

      <!-- Logs -->
      <TabItem Header="Logs">
        <Grid RowDefinitions="Auto,*,Auto" Margin="8" RowSpacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="View:" VerticalAlignment="Center"/>
            <ComboBox ItemsSource="{Binding Logs.Views}" SelectedItem="{Binding Logs.SelectedView}" MinWidth="140"/>
          </StackPanel>
          <ListBox x:Name="LogList" Grid.Row="1" ItemsSource="{Binding Logs.LogEntries}"
                   FontFamily="Consolas" FontSize="12" BorderThickness="0">
            <!-- The Fluent ListBoxItem has generous padding and a min height, which reads as a
                 blank line between every two log lines. Flatten it for this dense list. -->
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="6,1"/>
                <Setter Property="MinHeight" Value="0"/>
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="game:LogEntry">
                <TextBlock Text="{Binding Text}"
                           Foreground="{Binding Severity, Converter={StaticResource LogSeverityToBrush}}"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <Button Content="Clear" Command="{Binding Logs.ClearCommand}"/>
            <Button Content="Save..." Command="{Binding Logs.SaveCommand}"/>
            <Button Content="Open logs folder" Command="{Binding Logs.OpenLogsFolderCommand}"/>
          </StackPanel>
        </Grid>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
