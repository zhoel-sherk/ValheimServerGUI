<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ValheimServerGUI.Avalonia.ViewModels"
        x:Class="ValheimServerGUI.Avalonia.Views.AboutWindow"
        x:DataType="vm:AboutViewModel"
        Title="About"
        Width="420" Height="300"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">

  <StackPanel Margin="24" Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
    <TextBlock Text="Valheim Server GUI" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
    <TextBlock Text="(Avalonia client)" HorizontalAlignment="Center" Opacity="0.6"/>
    <TextBlock Text="{Binding VersionText}" HorizontalAlignment="Center"/>
    <TextBlock Text="{Binding BuildDateText}" HorizontalAlignment="Center"/>
    <TextBlock Text="Licensed under GNU GPLv3" HorizontalAlignment="Center" Opacity="0.7"/>
    <Button Content="Report an Issue" Click="OnReportIssueClick" HorizontalAlignment="Center"/>
    <Button Content="Close" IsCancel="True" MinWidth="100" HorizontalAlignment="Center"/>
  </StackPanel>
</Window>