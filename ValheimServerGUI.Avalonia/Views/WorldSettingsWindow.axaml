<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ValheimServerGUI.Avalonia.ViewModels"
        xmlns:game="using:ValheimServerGUI.Game"
        x:Class="ValheimServerGUI.Avalonia.Views.WorldSettingsWindow"
        x:DataType="vm:WorldSettingsViewModel"
        Title="{Binding Title}"
        Width="560" Height="680"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">

  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button Content="Restore Defaults" Command="{Binding RestoreDefaultsCommand}" MinWidth="130"/>
      <Button Content="Cancel" IsCancel="True" MinWidth="80"/>
      <Button Content="Apply" Command="{Binding ApplyCommand}" IsDefault="True" MinWidth="80" Click="OnApplyClick"/>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,12,0,0">
      <Border Padding="10" CornerRadius="4" Background="{DynamicResource VsgPanelBrush}"
              IsVisible="{Binding IsServerRunning}">
        <TextBlock Text="{Binding RestartNotice}" TextWrapping="Wrap" Foreground="{DynamicResource VsgWarningBrush}"/>
      </Border>

      <Border Padding="10" CornerRadius="4" Background="{DynamicResource VsgPanelBrush}"
              IsVisible="{Binding WorldAlreadyExists}">
        <StackPanel Spacing="4">
          <TextBlock Text="This world has already been generated."
                     TextWrapping="Wrap" Foreground="{DynamicResource VsgWarningBrush}"/>
          <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource VsgMutedTextBrush}"
                     Text="Difficulty modifiers are baked in when a world is generated, so raising the difficulty of an existing world will mostly only affect newly generated areas. Some options may have no effect at all. To apply the full change, delete the world and start it again from scratch."/>
        </StackPanel>
      </Border>
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="12">
        <StackPanel Spacing="4">
          <TextBlock Text="Difficulty Preset" FontWeight="SemiBold"/>
          <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" HorizontalAlignment="Left" MinWidth="240">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="game:WorldSettingOption">
                <TextBlock Text="{Binding DisplayName}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>

        <TextBlock Text="Modifiers" FontWeight="SemiBold"/>
        <Border Padding="12" CornerRadius="4" Background="{DynamicResource VsgPanelBrush}">
          <ItemsControl ItemsSource="{Binding Modifiers}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:WorldModifierRowViewModel">
                <Grid ColumnDefinitions="160,*" RowDefinitions="Auto" ColumnSpacing="8" Margin="0,4">
                  <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                  <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                            ItemsSource="{Binding Options}"
                            SelectedItem="{Binding SelectedOption}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="game:WorldSettingOption">
                        <TextBlock Text="{Binding DisplayName}"/>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <TextBlock Text="Additional Keys" FontWeight="SemiBold"/>
        <Border Padding="12" CornerRadius="4" Background="{DynamicResource VsgPanelBrush}">
          <ItemsControl ItemsSource="{Binding Keys}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:WorldKeyRowViewModel">
                <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsChecked}" Margin="0,4"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Read more about world modifiers on the" VerticalAlignment="Center"/>
          <Button Content="Valheim Wiki" Command="{Binding OpenModifiersHelpCommand}"/>
        </StackPanel>

        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource VsgMutedTextBrush}"
                   Text="Modifiers not working as expected? You may already have modifiers set in-game. Presets override the modifiers and keys above."/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
