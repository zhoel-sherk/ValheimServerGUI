<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ValheimServerGUI.Avalonia.ViewModels"
        x:Class="ValheimServerGUI.Avalonia.Views.PreferencesWindow"
        x:DataType="vm:PreferencesViewModel"
        Title="Preferences"
        Width="520" Height="420"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">

  <StackPanel Margin="16" Spacing="16">
    <CheckBox Content="Save server profile on start" IsChecked="{Binding SaveProfileOnStart}"/>
    <CheckBox Content="Check for updates on startup" IsChecked="{Binding CheckForUpdates}"/>
    <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}"/>
    <CheckBox Content="Start minimized" IsChecked="{Binding StartMinimized}"/>
    <CheckBox Content="Write application logs to file" IsChecked="{Binding WriteApplicationLogsToFile}"/>
    <CheckBox Content="Enable password validation" IsChecked="{Binding EnablePasswordValidation}"/>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
      <Button Content="Defaults" Command="{Binding ApplyDefaultsCommand}" MinWidth="80"/>
      <Button Content="Cancel" IsCancel="True" MinWidth="80"/>
      <Button Content="OK" Command="{Binding SaveCommand}" IsDefault="True" MinWidth="80"/>
    </StackPanel>
  </StackPanel>
</Window>