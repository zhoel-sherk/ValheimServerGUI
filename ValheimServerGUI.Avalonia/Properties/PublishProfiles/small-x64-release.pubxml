<?xml version="1.0" encoding="utf-8"?>
<!--
Publish profile for the Avalonia client: framework-dependent single-file win-x64 exe.
Native libraries (Skia/HarfBuzz) are bundled and self-extracted at startup.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>..\publish\avalonia-small-x64\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>False</SelfContained>
    <PublishSingleFile>True</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>True</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>True</PublishReadyToRun>
  </PropertyGroup>
</Project>
